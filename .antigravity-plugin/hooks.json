{
  "aetheris-microbrains": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|edit_file|write_file|replace_file_content|multi_replace_file_content|write_to_file|read_file|view_file|grep_search|find_by_name|list_dir|mcp_.*",
        "hooks": [
          {
            "type": "command",
            "command": "python -m aetheris_microbrains.hook --host antigravity --profile dev --log-decisions --session-state auto",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command|edit_file|write_file|replace_file_content|multi_replace_file_content|write_to_file|read_file|view_file|grep_search|find_by_name|list_dir|mcp_.*",
        "hooks": [
          {
            "type": "command",
            "command": "python -m aetheris_microbrains.hook --host antigravity --event post-tool-use --log-decisions --session-state auto",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
